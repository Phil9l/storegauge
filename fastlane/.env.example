# Copy this file to fastlane/.env and fill in the values locally.
# Never commit the real .env file or the .p8 private key.

FASTLANE_OPT_OUT_USAGE=1
FASTLANE_SKIP_UPDATE_CHECK=1

FASTLANE_ASC_KEY_ID=XXXXXXXXXX
FASTLANE_ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
FASTLANE_ASC_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8

STOREGAUGE_APP_IDENTIFIER=com.bazun.storegauge
STOREGAUGE_TEAM_ID=75RZ97C25R

# Optional when the Apple ID belongs to more than one App Store Connect team.
# FASTLANE_ITC_TEAM_ID=
# FASTLANE_USER=developer@example.com
