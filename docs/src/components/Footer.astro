---
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-intro">
      <a class="wordmark" href={base}>
        <img src={`${base}assets/storegauge.svg`} alt="" width="34" height="35" />
        <span>StoreGauge</span>
      </a>
      <p>Your app-store business on Mac and iPhone.</p>
    </div>
    <div class="footer-links">
      <div>
        <strong>Product</strong>
        <a href={`${base}#product`}>Overview</a>
        <a href={`${base}#privacy`}>Privacy</a>
        <a href={`${base}#mcp`}>MCP</a>
      </div>
      <div>
        <strong>Resources</strong>
        <a href="https://apps.apple.com/us/app/storegauge/id6794583347">App Store</a>
        <a href={`${base}docs/`}>Documentation</a>
        <a href={`${base}privacy/`}>Privacy policy</a>
        <a href="https://github.com/Phil9l/storegauge/releases">Releases</a>
      </div>
      <div>
        <strong>Project</strong>
        <a href="https://github.com/Phil9l/storegauge">GitHub · Free source</a>
        <a href="https://github.com/Phil9l/storegauge/issues">Issues</a>
        <a href="https://github.com/Phil9l/storegauge/blob/main/LICENSE">PolyForm Noncommercial</a>
      </div>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© 2026 StoreGauge contributors</span>
    <span>Native Mac + iPhone · Source available · Local first</span>
  </div>
</footer>
